{
  "expo": {
    "name": "Cronwatch",
    "slug": "cronwatch",
    "version": "1.0.0",
    "scheme": "cronwatch",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.konradgnat.cronwatch",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Cronwatch records short voice memos so you can log time entries by speaking.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.387703217931-uatt5herfhc7ptrqv0s61tqm0h4cbai2"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.konradgnat.cronwatch",
      "permissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAF7"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Cronwatch records short voice memos so you can log time entries by speaking."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
