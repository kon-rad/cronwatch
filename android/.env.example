# Copy values into ./local.properties (one KEY=value per line).
# Each one is wired into BuildConfig at compile time.
# If any are blank, the app falls back to stub mode for that subsystem.

FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# OAuth client ID of *type Web*, configured in Google Cloud + Firebase.
# Used by CredentialManager to mint the ID token Firebase Auth consumes.
GOOGLE_WEB_CLIENT_ID=

# https://your-deployment.example.com  — the Express server in ../server.
CAPTURE_PROXY_URL=

# RevenueCat Android API key.
REVENUECAT_API_KEY_ANDROID=
