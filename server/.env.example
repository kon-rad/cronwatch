# Listen on this port (DigitalOcean App Platform sets PORT automatically).
PORT=8080

# Comma-separated list of origins allowed to hit the proxy.
# Use * during development; lock down to your app/web origin in production.
ALLOWED_ORIGINS=*

# --- Firebase Admin (used to verify ID tokens from the mobile client) ---
# Either set FIREBASE_SERVICE_ACCOUNT_JSON to the full JSON service-account
# string, OR set the three discrete fields below. Pick one.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=cronwatch-3501b
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Deepgram (optional) ---
# Only needed when a client selects the "deepgram" transcription provider.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- Together AI ---
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Cheap cloud transcription model for the "together" provider.
TOGETHER_WHISPER_MODEL=openai/whisper-large-v3
