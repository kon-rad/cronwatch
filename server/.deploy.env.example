# Copy this to `.deploy.env` and fill in. `.deploy.env` is gitignored
# because the droplet IP is environment-specific. Everything in here is
# transport (where + how to ssh), not secret app config.

# DigitalOcean droplet IP or hostname.
DROPLET_HOST=203.0.113.10

# SSH user. Fresh DO droplets give you root by default.
SSH_USER=root

# Optional: ssh port. Default 22.
SSH_PORT=22

# Optional: identity file. Leave empty to use the agent / default key.
SSH_KEY=

# Where the app lives on the server. Created by setup-server.sh.
REMOTE_PATH=/opt/cronwatch-server

# PM2 process name. Must match ecosystem.config.cjs.
SERVICE_NAME=cronwatch-server
