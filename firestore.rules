rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/entries/{entryId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.resource.data.startTime;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.resource.data.startTime;
    }
    match /users/{uid}/reports/{reportId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // API keys: users can create/read/delete their own keys.
    // keyHash is write-once (immutable after creation) so the server can trust it.
    // The server reads these via Admin SDK (bypasses these rules).
    // NOTE: 'list' is separate from 'get' — resource.data is undefined during query
    // evaluation so it cannot appear in a list rule; the query's own whereField("uid")
    // constraint provides the actual per-user filtering.
    match /apiKeys/{keyId} {
      allow get, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.keyHash is string
        && request.resource.data.keyHash.size() == 64
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 64;
    }
  }
}
